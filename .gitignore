.quarto/
*_files/
*.pdf
poster.html

# Rendered Typst intermediates only -- Quarto writes these under .quarto/
# (already ignored above), never directly in a template or extension dir.
# Do NOT broaden this to a bare `*.typ`: that previously matched (and
# silently untracked) the vendored extension source below.
templates/**/poster.typ

# ...but never ignore the vendored Typst extension source itself, including
# the local patches documented in README.md ("Notes / gotchas").
!_extensions/**/*.typ

/.quarto/
**/*.quarto_ipynb

# docs/ is NOT build output here -- it's the committed, rendered site that
# GitHub Pages serves directly (Settings -> Pages: branch main, /docs; see
# docs-src/_quarto.yml). The actual build artifact to ignore is docs-src's
# own scratch _site/ (left over from a plain `quarto preview`, which doesn't
# honor output-dir); .quarto/ caches under docs-src/ are already covered by
# the bare ".quarto/" pattern above.
docs-src/_site/
docs-src/images/
